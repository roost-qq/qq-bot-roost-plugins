{
  "api": 1,
  "kind": "dsh-extension",
  "id": "voice-reply",
  "serverName": "voice-reply",
  "name": "语音回复",
  "description": "角色语音合成、台词库与试听；依赖 GPT-SoVITS v2 服务和角色模型，由聊天工具触发",
  "version": "1.1.6",
  "transport": "stdio",
  "command": "node",
  "args": ["server.mjs"],
  "scopes": [],
  "config": {
    "enabled": { "type": "boolean", "label": "启用语音工具", "default": true },
    "api": { "type": "string", "label": "GPT-SoVITS API 地址", "default": "http://127.0.0.1:9880", "maxLength": 2048, "hint": "api_v2.py 的根地址；不是 WebUI。远程服务建议使用 HTTPS。" },
    "refAudio": { "type": "string", "label": "参考音频路径", "default": "", "maxLength": 2048, "hint": "GPT-SoVITS 服务所在机器上的路径。" },
    "promptText": { "type": "string", "label": "参考音频原文", "default": "", "maxLength": 2000 },
    "promptLang": { "type": "select", "label": "参考音频语言", "default": "ja", "options": ["ja", "zh", "en", "auto"] },
    "sovitsWeights": { "type": "string", "label": "SoVITS 权重路径", "default": "", "maxLength": 2048, "hint": "相对 GPT-SoVITS 工作目录或服务支持的绝对路径。" },
    "gptWeights": { "type": "string", "label": "GPT 权重路径", "default": "", "maxLength": 2048 },
    "textLang": { "type": "select", "label": "正文语言", "default": "auto", "options": ["auto", "ja", "zh", "en"], "hint": "auto 按正文识别；纯汉字日文请选 ja。" },
    "speed": { "type": "number", "label": "语速", "default": 1, "min": 0.5, "max": 2 },
    "textSplitMethod": { "type": "select", "label": "怎么切句", "default": "cut5", "options": ["cut0", "cut1", "cut2", "cut3", "cut4", "cut5"] },
    "fragmentInterval": { "type": "number", "label": "句间停顿秒数", "default": 0.3, "min": 0.01, "max": 1 },
    "topK": { "type": "number", "label": "top_k", "default": 15, "min": 1, "max": 100, "integer": true },
    "topP": { "type": "number", "label": "top_p", "default": 1, "min": 0, "max": 1 },
    "temperature": { "type": "number", "label": "temperature", "default": 1, "min": 0.01, "max": 2 },
    "freeze": { "type": "boolean", "label": "复用上次语义结果", "default": false, "hint": "同一正文复用 GPT 语义来调速或换音色，避免重新采样；一键启动的服务支持此功能。" },
    "serviceDir": { "type": "string", "label": "GPT-SoVITS 安装目录", "default": "", "maxLength": 2048, "hint": "选择包含 api_v2.py 和 runtime 或 .venv/venv 的根目录；保存后点击一键启动。仅本机服务需要。" },
    "maxChars": { "type": "number", "label": "最多合成字符数", "default": 60, "min": 10, "max": 300, "integer": true },
    "cooldownSec": { "type": "number", "label": "同一会话冷却秒数", "default": 3, "min": 0, "max": 120 },
    "timeoutSec": { "type": "number", "label": "单次任务总超时秒数", "default": 60, "min": 5, "max": 120, "integer": true },
    "replyNote": { "type": "boolean", "label": "语音附带文字", "default": false },
    "keywords": { "type": "string", "label": "语音请求示例关键词", "default": "说话,语音回复,说句话,发个语音,语音条,念一句", "maxLength": 200, "hint": "供工具解析请求使用；扩展由模型调用，不是框架关键词监听器。" },
    "lines": { "type": "array", "label": "自定义台词（优先抽取）", "default": [], "items": { "type": "string" }, "maxItems": 100 },
    "translateApi": { "type": "string", "label": "可选日语翻译 API", "default": "", "maxLength": 2048, "hint": "OpenAI 兼容 /v1 地址。留空直接念原文；失败也保留原文。" },
    "translateKey": { "type": "string", "label": "翻译 API 密钥", "secret": true, "maxLength": 4096 },
    "translateModel": { "type": "string", "label": "翻译模型", "default": "gpt-4o-mini", "maxLength": 128 }
  },
  "usage": "用户要求说话、语音回复、发个语音或念一句时，调用 voice_reply：需要回答问题则先组织简短答案放入 text；复述给定句子也用 text；只要随口一句时留空。成功后最终仅输出返回的 reply（内含 <<voice: 路径>>），不要再用 qq_send 或内置 say 重发。失败按工具返回说明回复文字，不声称已发语音。",
  "ui": {
    "nav": { "label": "语音回复", "group": "express" },
    "page": "page.html",
    "runtime": "inprocess",
    "entry": "actions-v4.mjs",
    "actions": [
      { "id": "status", "label": "读取运行状态" },
      { "id": "probe", "label": "检查服务" },
      { "id": "startPreview", "label": "生成试听" },
      { "id": "job", "label": "读取试听进度" },
      { "id": "audio", "label": "读取试听音频" },
      { "id": "profiles", "label": "管理音色方案" },
      { "id": "service", "label": "管理本机语音服务" }
    ]
  }
}
